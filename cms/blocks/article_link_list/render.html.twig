{% trans_default_domain 'sfs_cms_blocks' %}
{% set articles = articles|default([]) %}

{% if articles is not empty %}
    <aside class="article-aside sticky-md-top pt-5">
        <h2 class="article-aside__title">{{ title|default('article_link_list.title'|trans) }}</h2>
        <ol class="article-aside__list">
            {% for article in articles %}
                {% set routePath = article.getCanonicalRoutePath(app.request.locale) ?: article.getCanonicalRoutePath() %}
                {% set articleUrl = routePath ? sfs_cms_route_path_path(routePath) : '#' %}

                <li class="article-aside__list-item"><h3 class="mb-0"><a href="{{ articleUrl }}" class="article-aside__list-item-title">{{ article.extraData.title[app.request.locale]|default(article.name) }}</a></h3></li>
            {% endfor %}
        </ol>
    </aside>
{% endif %}
