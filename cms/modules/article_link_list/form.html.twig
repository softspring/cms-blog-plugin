{{ sfs_cms_admin_module_accordion_block_start(form, accordion, 'attributes') }}
<div class="col-12">
    {{ form_row(form.id) }}
</div>
<div class="col-12">
    {{ form_row(form.class) }}
</div>
{{ sfs_cms_admin_module_accordion_block_end() }}

{{ sfs_cms_admin_module_accordion_block_start(form, accordion, 'article_filters', true) }}
{% if form.title is defined %}
<div class="col-12">
    {{ form_row(form.title, {'attr': {'data-article-list-preview-param': 'title'}}) }}
</div>
{% endif %}
<div class="col-12">
    {{ form_row(form.tag, {'attr': {'data-article-list-preview-param': 'tag'}}) }}
</div>
<div class="col-12">
    {{ form_row(form.limit, {'attr': {'data-article-list-preview-param': 'limit'}}) }}
</div>
<div class="col-12">
    {{ form_row(form.order, {'attr': {'data-article-list-preview-param': 'article_order'}}) }}
</div>
{{ sfs_cms_admin_module_accordion_block_end() }}
