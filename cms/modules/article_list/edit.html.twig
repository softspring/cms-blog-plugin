{% trans_default_domain 'sfs_cms_modules' %}
{% import '@SfsCms/macros/modules_edit.html.twig' as module %}

<div {{ module.link_id(form.id) }} {{ module.link_class(form.class) }}>
{% for site in form.vars.sites %}
    {% for locale in form.vars.locales %}
        <div style="pointer-events: none;cursor: default;" data-article-list-preview data-lang="{{ locale }}" data-site="{{ site }}" class="section-preview"
             data-preview-url="{{ url('sfs_cms_admin_blocks_render_preview_by_type', {
                 'type': 'article_list',
                 'current_route': '',
                 '_locale': locale,
                 '_sfs_cms_site': site,
                 'cms-edit': true,
                 'show_filter_form': form.show_filter_form.vars.data ? 1 : 0,
                 'tag': form.tag.vars.data|default(''),
                 'limit': form.limit.vars.data|default(''),
                 'article_order': form.order.vars.data|default('published_at_desc')
             }) }}"
        ></div>
    {% endfor %}
{% endfor %}
</div>