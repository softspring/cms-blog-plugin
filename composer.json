{
    "name": "softspring/cms-blog-plugin",
    "description": "A Blog extension for softspring cms",
    "type": "sfs-cms-plugin",
    "license": "AGPL-3.0-or-later",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "softspring/cms-bundle": "^6.0@dev",
        "scienta/doctrine-json-functions": "^5.2",
        "softspring/time-ago-bundle": "^6.0@dev",
        "symfony/translation": "^6.4|^7.4|^8.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.2"
    },
    "suggest": {
        "softspring/user-bundle": "If you want to use users as blog authors"
    },
    "autoload": {
        "psr-4": {
            "Softspring\\CmsBlogPlugin\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "fix": [
            "vendor/bin/rector process src tests",
            "vendor/bin/php-cs-fixer fix --diff",
            "composer normalize"
        ],
        "run-tests" : [
            "composer validate --strict --no-check-lock --ansi",
            "XDEBUG_MODE=coverage vendor/bin/phpunit",
            "vendor/bin/rector process src tests --dry-run",
            "vendor/bin/phpstan analyse src tests --level 5",
            "vendor/bin/php-cs-fixer fix --dry-run --diff",
            "vendor/bin/yaml-lint .github/ -vvv --parse-tags",
            "vendor/bin/yaml-lint config/ -vvv --parse-tags",
            "vendor/bin/yaml-lint translations/ -vvv --parse-tags"
        ],
        "test": [
            "composer update --no-scripts --ansi",
            "@run-tests"
        ],
        "test-bc": [
            "composer update --no-scripts --ansi --prefer-lowest --prefer-stable",
            "@run-tests"
        ]
    }
}
